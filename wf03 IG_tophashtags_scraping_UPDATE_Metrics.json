      "parameters": {
        "jsCode": "const seen = new Set();\nconst urls = [];\n\nfor (const item of items) {\n  const raw = item.json.url;\n  if (!raw) continue;\n\n  const url = String(raw).trim();\n  if (!url || seen.has(url)) continue;\n\n  seen.add(url);\n  urls.push(url);\n}\n\nreturn [\n  {\n    json: {\n      urls,\n    },\n  },\n];"
      },
