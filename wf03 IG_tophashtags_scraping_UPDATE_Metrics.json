    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst MAX_POSTS_PER_RUN = 1000;\n\nfunction toMs(value) {\n  if (value == null || value === '') return NaN;\n  const t = Date.parse(value);\n  return Number.isFinite(t) ? t : NaN;\n}\n\nconst trackedDue = [];\nconst untrackedDue = [];\n\nfor (const item of items) {\n  const row = item.json || {};\n  const status = String(row.tracking_status || '').trim().toLowerCase();\n  if (status === 'stopped_stagnant') continue;\n\n  const nextCheckMs = toMs(row.next_check_at);\n  if (Number.isFinite(nextCheckMs) && nextCheckMs > now) continue;\n\n  const hasTrackingState = Boolean(\n    row.last_checked_at ||\n    row.window_started_at ||\n    row.last_views != null\n  );\n\n  (hasTrackingState ? trackedDue : untrackedDue).push(item);\n}\n\nreturn trackedDue.concat(untrackedDue).slice(0, MAX_POSTS_PER_RUN);"
      },
      "id": "6d3ea6da-e279-4892-b744-388366178133",
      "name": "Code: Filter due posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        528
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\nconst CFG = {\n  ACTIVE_INTERVAL_DAYS: 1,\n  WINDOW_HOURS: 72,\n  MIN_WINDOW_GROWTH_PCT: 0.10,\n};\n\nfunction num(value) {\n  const n = Number(value);\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction toMs(value) {\n  if (value == null || value === '') return NaN;\n  const t = Date.parse(value);\n  return Number.isFinite(t) ? t : NaN;\n}\n\nfunction addDays(date, days) {\n  return new Date(date.getTime() + days * DAY_MS).toISOString();\n}\n\nfunction normalizeUrl(value) {\n  if (!value) return '';\n  const raw = String(value).trim();\n  if (!raw) return '';\n  try {\n    const u = new URL(raw);\n    u.hash = '';\n    u.search = '';\n    u.pathname = u.pathname.replace(/\\/+$/, '');\n    return u.toString().replace(/\\/+$/, '').toLowerCase();\n  } catch {\n    return raw.replace(/\\/+$/, '').toLowerCase();\n  }\n}\n\nfunction shortcodeFromUrl(value) {\n  const match = String(value || '').match(\n    /instagram\\.com\\/(?:reel|p|tv)\\/([^/?#]+)/i\n  );\n  return match ? match[1] : '';\n}\n\nfunction getShortcode(row) {\n  return row.shortCode || row.shortcode || row.code ||\n    shortcodeFromUrl(row.url || row.inputUrl);\n}\n\nfunction getViews(row) {\n  return Math.max(\n    num(row.videoPlayCount),\n    num(row.videoViewCount),\n    num(row.play_count),\n    num(row.ig_play_count),\n    num(row.views)\n  );\n}\n\nfunction getLikes(row) {\n  return num(row.likesCount ?? row.like_count);\n}\n\nfunction getComments(row) {\n  return num(row.commentsCount ?? row.comment_count);\n}\n\nlet previousItems = [];\ntry {\n  previousItems = $items('Code: Filter due posts').map(item => item.json);\n} catch {\n  previousItems = [];\n}\n\nconst prevByUrl = new Map();\nconst prevByShortcode = new Map();\n\nfor (const prev of previousItems) {\n  const normalized = normalizeUrl(prev.url);\n  if (normalized) prevByUrl.set(normalized, prev);\n  const shortcode =\n    prev.shortcode || prev.shortCode || shortcodeFromUrl(prev.url);\n  if (shortcode) prevByShortcode.set(String(shortcode), prev);\n}\n\nreturn items.map(item => {\n  const row = item.json || {};\n  const shortcode = getShortcode(row);\n  const candidateUrls = [\n    row.inputUrl,\n    row.url,\n    shortcode ? 'https://www.instagram.com/reel/' + shortcode : '',\n    shortcode ? 'https://www.instagram.com/p/' + shortcode : '',\n  ];\n\n  let prev = null;\n  for (const candidate of candidateUrls) {\n    const normalized = normalizeUrl(candidate);\n    if (normalized && prevByUrl.has(normalized)) {\n      prev = prevByUrl.get(normalized);\n      break;\n    }\n  }\n\n  if (!prev && shortcode) prev = prevByShortcode.get(String(shortcode));\n  if (!prev) prev = {};\n\n  const views = getViews(row);\n  const likes = getLikes(row);\n  const comments = getComments(row);\n\n  const hadPreviousState = Boolean(\n    prev.last_checked_at ||\n    prev.window_started_at ||\n    prev.last_views != null\n  );\n\n  const prevViews = num(prev.last_views);\n  const prevLikes = num(prev.last_likes);\n  const prevComments = num(prev.last_comments);\n\n  const deltaViews = hadPreviousState ? views - prevViews : 0;\n  const deltaLikes = hadPreviousState ? likes - prevLikes : 0;\n  const deltaComments = hadPreviousState ? comments - prevComments : 0;\n\n  let windowStartedAt = prev.window_started_at || null;\n  let windowStartViews = num(prev.window_start_views);\n  let growth3dPct = 0;\n  let trackingStatus = 'active';\n  let nextCheckAt = addDays(now, CFG.ACTIVE_INTERVAL_DAYS);\n  let stoppedAt = null;\n  let stopReason = '';\n\n  const windowStartedMs = toMs(windowStartedAt);\n  const hasWindow =\n    Number.isFinite(windowStartedMs) &&\n    prev.window_start_views != null;\n\n  if (!hasWindow) {\n    windowStartedAt = now.toISOString();\n    windowStartViews = views;\n  } else {\n    growth3dPct = windowStartViews > 0\n      ? Math.max(0, views - windowStartViews) / windowStartViews\n      : (views > 0 ? 1 : 0);\n\n    const windowAgeHours =\n      (now.getTime() - windowStartedMs) / (60 * 60 * 1000);\n\n    if (windowAgeHours >= CFG.WINDOW_HOURS) {\n      if (growth3dPct >= CFG.MIN_WINDOW_GROWTH_PCT) {\n        windowStartedAt = now.toISOString();\n        windowStartViews = views;\n        growth3dPct = 0;\n      } else {\n        trackingStatus = 'stopped_stagnant';\n        nextCheckAt = null;\n        stoppedAt = now.toISOString();\n        stopReason = 'views_growth_below_10pct_over_72h';\n      }\n    }\n  }\n\n  const trackingUrl =\n    prev.url ||\n    row.inputUrl ||\n    row.url ||\n    (shortcode\n      ? 'https://www.instagram.com/reel/' + shortcode + '/'\n      : '');\n\n  const lastGrowthAt = deltaViews > 0\n    ? now.toISOString()\n    : (prev.last_growth_at || null);\n\n  const noGrowthChecks = deltaViews > 0\n    ? 0\n    : num(prev.no_growth_checks) + (hadPreviousState ? 1 : 0);\n\n  return {\n    json: {\n      ...row,\n      tracking_url: trackingUrl,\n      tracking_shortcode: shortcode,\n      tracking_status: trackingStatus,\n      last_checked_at: now.toISOString(),\n      last_growth_at: lastGrowthAt,\n      last_views: views,\n      last_likes: likes,\n      last_comments: comments,\n      delta_views: deltaViews,\n      delta_likes: deltaLikes,\n      delta_comments: deltaComments,\n      no_growth_checks: noGrowthChecks,\n      next_check_at: nextCheckAt,\n      window_started_at: windowStartedAt,\n      window_start_views: windowStartViews,\n      growth_3d_pct: growth3dPct,\n      stopped_at: stoppedAt,\n      stop_reason: stopReason,\n    },\n  };\n});"
      },
