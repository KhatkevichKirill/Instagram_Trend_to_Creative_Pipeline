    {
      "parameters": {
        "jsCode": "/**\n * Keeps only rows that are due for an Apify refresh.\n * New rows with no Data Table state pass through immediately.\n */\nconst now = Date.now();\n\nfunction toMs(value) {\n  if (value == null || value === '') return NaN;\n  const t = Date.parse(value);\n  return Number.isFinite(t) ? t : NaN;\n}\n\nreturn items.filter(item => {\n  const row = item.json;\n  const nextCheckMs = toMs(row.next_check_at);\n  if (!Number.isFinite(nextCheckMs)) return true;\n  return nextCheckMs <= now;\n});"
      },
      "id": "9d9f980a-8d70-4034-9689-adf480c27ac2",
      "name": "Code: Filter due posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        1232
      ]
    },
    {
      "parameters": {
        "jsCode": "/**\n * Compares fresh Apify metrics with the previous Data Table state and decides\n * when each reel should be checked again.\n */\nconst now = new Date();\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\nconst CFG = {\n  ACTIVE_INTERVAL_DAYS: 1,\n  COOLDOWN_INTERVAL_DAYS: 2,\n  PAUSED_INTERVAL_DAYS: 7,\n  NO_GROWTH_CHECKS_TO_PAUSE: 3,\n};\n\nfunction num(value) {\n  const n = Number(value);\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction addDays(date, days) {\n  return new Date(date.getTime() + days * DAY_MS).toISOString();\n}\n\nfunction normalizeUrl(value) {\n  if (!value) return '';\n  const raw = String(value).trim();\n  if (!raw) return '';\n\n  try {\n    const u = new URL(raw);\n    u.hash = '';\n    u.search = '';\n    u.pathname = u.pathname.replace(/\\/+$/, '');\n    return u.toString().replace(/\\/+$/, '').toLowerCase();\n  } catch {\n    return raw.replace(/\\/+$/, '').toLowerCase();\n  }\n}\n\nfunction shortcodeFromUrl(value) {\n  const raw = String(value || '');\n  const m = raw.match(/instagram\\.com\\/(?:reel|p|tv)\\/([^/?#]+)/i);\n  return m ? m[1] : '';\n}\n\nfunction getShortcode(row) {\n  return row.shortCode || row.shortcode || row.code || shortcodeFromUrl(row.url || row.inputUrl);\n}\n\nfunction getViews(row) {\n  return Math.max(\n    num(row.videoPlayCount),\n    num(row.videoViewCount),\n    num(row.play_count),\n    num(row.ig_play_count),\n    num(row.views)\n  );\n}\n\nfunction getLikes(row) {\n  return num(row.likesCount ?? row.like_count);\n}\n\nfunction getComments(row) {\n  return num(row.commentsCount ?? row.comment_count);\n}\n\nlet previousItems = [];\ntry {\n  previousItems = $items('Code: Filter due posts').map(item => item.json);\n} catch (error) {\n  previousItems = [];\n}\n\nconst prevByUrl = new Map();\nconst prevByShortcode = new Map();\nfor (const prev of previousItems) {\n  const normalized = normalizeUrl(prev.url);\n  if (normalized) prevByUrl.set(normalized, prev);\n\n  const shortcode = prev.shortcode || prev.shortCode || shortcodeFromUrl(prev.url);\n  if (shortcode) prevByShortcode.set(String(shortcode), prev);\n}\n\nreturn items.map(item => {\n  const row = item.json;\n  const shortcode = getShortcode(row);\n\n  const candidateUrls = [\n    row.inputUrl,\n    row.url,\n    shortcode ? 'https://www.instagram.com/reel/' + shortcode : '',\n    shortcode ? 'https://www.instagram.com/p/' + shortcode : '',\n  ];\n\n  let prev = null;\n  for (const candidate of candidateUrls) {\n    const normalized = normalizeUrl(candidate);\n    if (normalized && prevByUrl.has(normalized)) {\n      prev = prevByUrl.get(normalized);\n      break;\n    }\n  }\n  if (!prev && shortcode) prev = prevByShortcode.get(String(shortcode));\n  if (!prev) prev = {};\n\n  const views = getViews(row);\n  const likes = getLikes(row);\n  const comments = getComments(row);\n\n  const hadPreviousState =\n    prev.last_checked_at ||\n    prev.last_views != null ||\n    prev.last_likes != null ||\n    prev.last_comments != null;\n\n  const prevViews = num(prev.last_views);\n  const prevLikes = num(prev.last_likes);\n  const prevComments = num(prev.last_comments);\n\n  const deltaViews = hadPreviousState ? views - prevViews : 0;\n  const deltaLikes = hadPreviousState ? likes - prevLikes : 0;\n  const deltaComments = hadPreviousState ? comments - prevComments : 0;\n\n  const grew = !hadPreviousState || deltaViews > 0 || deltaLikes > 0 || deltaComments > 0;\n  const noGrowthChecks = grew ? 0 : num(prev.no_growth_checks) + 1;\n\n  let trackingStatus = 'active';\n  let nextCheckAt = addDays(now, CFG.ACTIVE_INTERVAL_DAYS);\n\n  if (!grew && noGrowthChecks >= CFG.NO_GROWTH_CHECKS_TO_PAUSE) {\n    trackingStatus = 'paused_no_growth';\n    nextCheckAt = addDays(now, CFG.PAUSED_INTERVAL_DAYS);\n  } else if (!grew) {\n    trackingStatus = 'cooldown';\n    nextCheckAt = addDays(now, CFG.COOLDOWN_INTERVAL_DAYS);\n  }\n\n  const trackingUrl = prev.url || row.inputUrl || row.url || (shortcode ? 'https://www.instagram.com/reel/' + shortcode + '/' : '');\n\n  return {\n    json: {\n      ...row,\n      tracking_url: trackingUrl,\n      tracking_shortcode: shortcode,\n      tracking_status: trackingStatus,\n      last_checked_at: now.toISOString(),\n      last_growth_at: grew ? now.toISOString() : (prev.last_growth_at || null),\n      last_views: views,\n      last_likes: likes,\n      last_comments: comments,\n      delta_views: deltaViews,\n      delta_likes: deltaLikes,\n      delta_comments: deltaComments,\n      no_growth_checks: noGrowthChecks,\n      next_check_at: nextCheckAt,\n    },\n  };\n});"
      },
