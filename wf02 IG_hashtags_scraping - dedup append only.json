    {
      "parameters": {
        "jsCode": "const SHORTCODE_RE = /instagram\\.com\\/(?:reel|p|tv)\\/([^\\/?#]+)/i;\n\nfunction collectPosts(raw) {\n  if (Array.isArray(raw)) return raw.flatMap(collectPosts);\n  if (!raw || typeof raw !== 'object') return [];\n\n  for (const key of ['items', 'posts', 'data', 'results']) {\n    if (Array.isArray(raw[key])) return raw[key].flatMap(collectPosts);\n  }\n\n  return [raw];\n}\n\nfunction extractShortcode(post) {\n  const direct = String(post.shortcode ?? post.code ?? post.shortCode ?? '').trim();\n  if (direct) return direct;\n\n  const url = String(post.post_url ?? post.url ?? '').trim();\n  const match = url.match(SHORTCODE_RE);\n  return match ? match[1] : '';\n}\n\nfunction toList(value) {\n  if (Array.isArray(value)) return value.filter(Boolean).join(',');\n  if (value == null) return '';\n  return String(value);\n}\n\nfunction normalizePost(post) {\n  const shortcode = extractShortcode(post);\n  const postedAt = post.posted_at ?? post.taken_at ?? '';\n  let takenAtTimestamp = post.taken_at_timestamp;\n  if (takenAtTimestamp == null && postedAt) {\n    const ms = Date.parse(postedAt);\n    if (!Number.isNaN(ms)) takenAtTimestamp = Math.floor(ms / 1000);\n  }\n\n  return {\n    ...post,\n    shortcode,\n    id: post.post_id ?? post.id ?? '',\n    url: post.post_url ?? post.url ?? (shortcode ? `https://www.instagram.com/reel/${shortcode}/` : ''),\n    taken_at: postedAt,\n    taken_at_timestamp: takenAtTimestamp ?? '',\n    scraped_at: post.scraped_at ?? '',\n    product_type: post.product_type ?? (post.is_reel ? 'clips' : ''),\n    media_type: post.media_type ?? '',\n    author: post.author_username ?? post.author ?? '',\n    caption: post.caption ?? '',\n    hashtags: toList(post.caption_hashtags ?? post.hashtags),\n    mentions: toList(post.mentions),\n    like_count: post.like_count ?? '',\n    comment_count: post.comment_count ?? '',\n    play_count: post.play_count ?? post.video_view_count ?? '',\n    video_url: post.video_url ?? '',\n    thumbnail_url: post.thumbnail_url ?? post.display_url ?? '',\n    duration_seconds: post.video_duration_secs ?? post.duration_seconds ?? '',\n    is_paid_partnership: post.is_paid_partnership ?? '',\n    location: post.location_name ?? post.location ?? '',\n    has_tagged_users: Array.isArray(post.tagged_users)\n      ? post.tagged_users.length > 0\n      : post.has_tagged_users ?? '',\n  };\n}\n\nconst state = $getWorkflowStaticData('global');\nconst sheetItems = $items('Get existing shortcodes');\nconst known = new Set([\n  ...(Array.isArray(state.shortcodeCache) ? state.shortcodeCache : []),\n  ...sheetItems.map(item => String(item.json.shortcode ?? '').trim()).filter(Boolean),\n]);\n\nconst output = [];\nfor (const item of $input.all()) {\n  for (const post of collectPosts(item.json)) {\n    const normalized = normalizePost(post);\n    const shortcode = String(normalized.shortcode ?? '').trim();\n    if (!shortcode || known.has(shortcode)) continue;\n\n    known.add(shortcode);\n    output.push({ json: normalized });\n  }\n}\n\nstate.shortcodeCache = [...known];\nreturn output;"
      },
