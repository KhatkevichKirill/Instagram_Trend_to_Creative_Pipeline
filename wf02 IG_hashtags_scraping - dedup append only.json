    {
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\nconst sheetItems = $items('Get existing shortcodes');\nconst known = new Set([\n  ...(Array.isArray(state.shortcodeCache) ? state.shortcodeCache : []),\n  ...sheetItems.map(item => String(item.json.shortcode ?? '').trim()).filter(Boolean),\n]);\n\nconst output = [];\nfor (const item of $input.all()) {\n  const shortcode = String(item.json.shortcode ?? '').trim();\n  if (!shortcode || known.has(shortcode)) continue;\n\n  known.add(shortcode);\n  output.push(item);\n}\n\nstate.shortcodeCache = [...known];\nreturn output;"
      },
