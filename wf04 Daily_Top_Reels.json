    {
      "parameters": {
        "jsCode": "/**\n * Daily Top Reels selector — n8n Code node (\"Run Once for All Items\").\n *\n * INPUT (one item per scraped row). Each item.json must contain the scraper\n * fields PLUS the previous snapshot attached by an upstream \"Data Table > Get\"\n * node (null/undefined if the reel was never seen before):\n *   product_type, like_count, comment_count, play_count, ig_play_count,\n *   reshare_count, taken_at_timestamp, id, shortcode, url, gd_file_id, ...\n *   prev_views, prev_likes, prev_seen_ts   <-- from Data Table lookup (by shortcode)\n *\n * OUTPUT: every reel that passes the quality gates, scored + ranked + momentum\n * flags. The top N NOT-yet-used reels carry is_pick=true. Downstream\n * \"Data Table > Upsert\" writes back the new snapshot, keyed on shortcode.\n */\n\n// ---------------------------------------------------------------- CONFIG\nconst CFG = {\n  MIN_VIEWS:      5000,    // hard floor: drop sub-noise reels\n  MIN_LIKE_RATE:  0.01,    // hard floor: kills inflated/dead views (3 likes / 160k)\n  HALF_LIFE_DAYS: 14,      // recency decay: 14d old => recency ~0.5\n  W_VIEWS:        0.30,    // weight: reach (percentile)\n  W_LIKE:         0.30,    // weight: like quality (percentile)\n  W_ENG:          0.20,    // weight: total engagement (percentile)\n  W_RECENCY:      0.20,    // weight: freshness (exp decay, 0..1)\n  MOMENTUM_PCT:   0.20,    // +20% views since last snapshot => momentum\n  MOMENTUM_BONUS: 0.10,    // score nudge so re-accelerating reels resurface\n  TOP_N:          5,       // how many to mark as picks\n  ADDED_FIELD:    'status',        // sheet column holding the used/queued status\n  ADDED_VALUE:    'moved_to_top',  // value that means \"already added\" -> skip from picks\n};\n\nconst num = (v) => {\n  const n = Number(v);\n  return Number.isFinite(n) ? n : 0;\n};\n\n// Accept either a unix-epoch (number or numeric string) or an ISO datetime\n// string and return milliseconds since epoch. Returns NaN if unparseable.\nconst toMs = (v) => {\n  if (v == null || v === '') return NaN;\n  if (typeof v === 'number') return v * 1000;          // epoch seconds\n  if (/^\\d+$/.test(String(v).trim())) return Number(v) * 1000; // \"1781119335\"\n  const t = Date.parse(v);                              // \"2026-06-10T19:22:15+00:00\"\n  return Number.isFinite(t) ? t : NaN;\n};\n\n// percentile rank (0..1) of each value within an array (ties -> average rank)\nfunction percentiles(values) {\n  const sorted = [...values].sort((a, b) => a - b);\n  return values.map((v) => {\n    let lo = 0, hi = 0;\n    for (const s of sorted) { if (s < v) lo++; if (s <= v) hi++; }\n    return (lo + hi) / 2 / sorted.length; // midrank / n\n  });\n}\n\nconst nowMs = Date.now();\nconst rows = $input.all().map((i) => i.json);\n\n// ----------------------------------------------------- GATES + FEATURES\nconst gated = [];\nfor (const r of rows) {\n  if (r.product_type !== 'clips') continue;             // reels only\n\n  const views  = Math.max(num(r.play_count), num(r.ig_play_count));\n  const likes  = num(r.like_count);\n  const comments = num(r.comment_count);\n  const shares = num(r.reshare_count);\n  const likeRate = views > 0 ? likes / views : 0;\n\n  if (views < CFG.MIN_VIEWS) continue;                  // floor: reach\n  if (likeRate < CFG.MIN_LIKE_RATE) continue;           // floor: kills fake views\n\n  const engRate = views > 0 ? (likes + comments + shares) / views : 0;\n  let tsMs = toMs(r.taken_at);                          // epoch field first\n  if (!Number.isFinite(tsMs)) tsMs = toMs(r.taken_at_timestamp); // ISO fallback\n  const ageDays = Number.isFinite(tsMs) ? (nowMs - tsMs) / 86400000 : 9999;\n  const recency = Math.exp(-ageDays / CFG.HALF_LIFE_DAYS);\n\n  // ---- momentum vs previous snapshot ----\n  const prevViews = r.prev_views != null ? num(r.prev_views) : null;\n  const prevLikes = r.prev_likes != null ? num(r.prev_likes) : null;\n  const isNew = prevViews == null;\n  const dViews = isNew ? 0 : views - prevViews;\n  const dLikes = isNew ? 0 : likes - prevLikes;\n  const prevSeenMs = r.prev_seen_ts ? new Date(r.prev_seen_ts).getTime() : null;\n  const daysSince = prevSeenMs ? Math.max((nowMs - prevSeenMs) / 86400000, 1) : null;\n  const velocity = daysSince ? dViews / daysSince : 0; // views/day since last run\n  const grewPct = prevViews && prevViews > 0 ? dViews / prevViews : 0;\n  const momentum = !isNew && grewPct >= CFG.MOMENTUM_PCT;\n\n  gated.push({\n    ...r,\n    views, likes, comments, shares,\n    like_rate: likeRate, eng_rate: engRate,\n    age_days: ageDays, recency,\n    is_new: isNew, d_views: dViews, d_likes: dLikes,\n    velocity, grew_pct: grewPct, momentum,\n  });\n}\n\n// ------------------------------------------------- PERCENTILES + SCORE\nconst pV = percentiles(gated.map((g) => g.views));\nconst pL = percentiles(gated.map((g) => g.like_rate));\nconst pE = percentiles(gated.map((g) => g.eng_rate));\n\ngated.forEach((g, idx) => {\n  g.p_views = pV[idx];\n  g.p_like  = pL[idx];\n  g.p_eng   = pE[idx];\n  g.score =\n    CFG.W_VIEWS   * g.p_views +\n    CFG.W_LIKE    * g.p_like +\n    CFG.W_ENG     * g.p_eng +\n    CFG.W_RECENCY * g.recency +\n    (g.momentum ? CFG.MOMENTUM_BONUS : 0);\n});\n\n// --------------------------------------------------- RANK + MARK PICKS\ngated.sort((a, b) => b.score - a.score);\nlet picked = 0;\ngated.forEach((g, i) => {\n  g.rank = i + 1;\n  // exclude already-used reels from picks, but keep them in the pool so\n  // percentiles stay stable and their snapshot keeps updating.\n  const alreadyAdded =\n    String(g[CFG.ADDED_FIELD] || '').trim() === CFG.ADDED_VALUE;\n  g.is_pick = !alreadyAdded && picked < CFG.TOP_N;\n  if (g.is_pick) picked++;\n  g.flag = g.is_new ? 'new' : (g.momentum ? 'momentum' : 'tracked');\n  // snapshot fields for the downstream Data Table > Upsert (key = shortcode)\n  g.snap_shortcode = g.shortcode;\n  g.snap_views = g.views;\n  g.snap_likes = g.likes;\n  g.snap_seen_ts = new Date(nowMs).toISOString().slice(0, 10);\n});\n\nreturn gated.map((json) => ({ json }));"
      },
