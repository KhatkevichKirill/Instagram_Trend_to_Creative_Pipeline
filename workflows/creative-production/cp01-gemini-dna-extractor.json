    {
      "parameters": {
        "jsCode": "const config = $('Pipeline Config').first().json;\n\nreturn items.map(item => {\n  const raw = item.json.DNA_Extractor;\n  let text = raw;\n\n  if (typeof raw === 'object' && raw !== null) {\n    text = raw.parts?.[0]?.text || JSON.stringify(raw);\n  }\n\n  text = String(text)\n    .replace(/^\\x60\\x60\\x60json\\s*/i, '')\n    .replace(/^\\x60\\x60\\x60\\s*/i, '')\n    .replace(/\\x60\\x60\\x60$/i, '')\n    .trim();\n\n  try {\n    const parsed = JSON.parse(text);\n    const score = parsed?.product_fit?.score ?? null;\n    const skipReason = parsed?.skip_reason;\n    const explicitSkip = skipReason && !['none', 'null'].includes(String(skipReason).toLowerCase());\n    const passesScore = Number(score) >= Number(config.scoring.min_product_fit_score);\n\n    item.json.product_fit_score = score;\n    item.json.product_fit_reason = parsed?.product_fit?.reason ?? null;\n    item.json.skip_reason = explicitSkip ? skipReason : null;\n    item.json.pipeline_status = !explicitSkip && passesScore ? 'dna_extracted' : 'skipped';\n    item.json.decision_reason = explicitSkip ? skipReason : (parsed?.product_fit?.reason ?? 'below-product-fit-threshold');\n  } catch (error) {\n    item.json.product_fit_score = null;\n    item.json.pipeline_status = 'analysis_error';\n    item.json.decision_reason = `JSON parse error: ${error.message}`;\n  }\n\n  return item;\n});"
      },
