    {
      "parameters": {
        "jsCode": "const productName = $('Pipeline Config').first().json.product.name;\nconst escapedProductName = String(productName).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst productNamePattern = new RegExp(escapedProductName, 'i');\nconst config = $('Pipeline Config').first().json;\nconst items = $input.all();\n\nconst SOURCE_COLUMN = \"final_prompt_seedance\";\n\nconst clean = (v) => String(v ?? \"\").replace(/\\s+/g, \" \").trim();\n\nfunction getSourceValue(json) {\n  if (Object.prototype.hasOwnProperty.call(json, SOURCE_COLUMN)) {\n    return json[SOURCE_COLUMN];\n  }\n\n  const fallbackKey = Object.keys(json).find((key) =>\n    clean(key).toLowerCase() === SOURCE_COLUMN.toLowerCase()\n  );\n\n  if (fallbackKey) return json[fallbackKey];\n\n  const availableKeys = Object.keys(json).join(\", \");\n  throw new Error(`Column not found: \"${SOURCE_COLUMN}\". Available columns: ${availableKeys}`);\n}\n\nfunction safeParseJsonString(raw) {\n  if (typeof raw !== \"string\") {\n    throw new Error(`Source column is not a string. Got: ${typeof raw}`);\n  }\n\n  let s = raw\n    .trim()\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/\\s*```$/i, \"\")\n    .trim();\n\n  if (!s) throw new Error(`Source column \"${SOURCE_COLUMN}\" is empty.`);\n\n  try {\n    return JSON.parse(s);\n  } catch (_) {}\n\n  const first = s.indexOf(\"{\");\n  const last = s.lastIndexOf(\"}\");\n  if (first !== -1 && last !== -1 && last > first) {\n    try {\n      return JSON.parse(s.slice(first, last + 1));\n    } catch (_) {}\n  }\n\n  throw new Error(`Could not parse JSON from column \"${SOURCE_COLUMN}\". First 300 chars: ${s.slice(0, 300)}`);\n}\n\nfunction normalizeDuration(value) {\n  const raw = clean(value || \"15\").toLowerCase();\n  const match = raw.match(/\\d+/);\n  if (!match) return 15;\n  return Math.max(4, Math.min(15, Number(match[0])));\n}\n\nfor (const { json } of items) {\n  const src = safeParseJsonString(getSourceValue(json));\n  const seedance = src.seedance || {};\n  const prompt = clean(seedance.prompt);\n\n  if (!prompt) {\n    throw new Error(`seedance.prompt is empty for id=${json.id || \"unknown\"}`);\n  }\n\n  if (prompt.length > 5000) {\n    throw new Error(`seedance.prompt is too long for id=${json.id || \"unknown\"}: ${prompt.length} chars`);\n  }\n\n  const dialogue = JSON.stringify(src.creative_brief?.dialogue || []);\n  if (productNamePattern.test(dialogue)) {\n    throw new Error(`Spoken dialogue contains the configured product brand for id=${json.id || \"unknown\"}`);\n  }\n\n  json.content_type = \"seedance_prompt_mvp\";\n  json.kie_payload = {\n    model: config.generation.seedance_model,\n    input: {\n      prompt,\n      duration: normalizeDuration(seedance.duration_sec || src.creative_brief?.duration_sec),\n      aspect_ratio: clean(seedance.aspect_ratio || src.creative_brief?.aspect_ratio) || config.generation.aspect_ratio,\n      resolution: clean(seedance.resolution) || \"1080p\",\n      generate_audio: seedance.generate_audio ?? true,\n    },\n  };\n  json.compiled_prompt_length = prompt.length;\n  json.source_column_used = SOURCE_COLUMN;\n  json.seedance_negative_prompt = clean(seedance.negative_prompt);\n}\n\nreturn items;"
      },
