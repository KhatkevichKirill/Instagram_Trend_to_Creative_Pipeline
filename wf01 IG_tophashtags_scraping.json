    {
      "parameters": {
        "jsCode": "// snapshot of current statuses from the `general` sheet\nconst prev = {};\nfor (const row of $('Get existing rows').all()) {\n  if (row.json.shortcode) prev[row.json.shortcode] = row.json.status;\n}\n\n// new reels -> 'scraped'; existing -> keep their current status\nreturn $input.all().map(item => {\n  const sc = item.json.shortcode;\n  item.json.status = (sc in prev && prev[sc]) ? prev[sc] : 'scraped';\n  return item;\n});"
      },
