        "sendQuery": true,
        "url": "https://1.1.1.1/dns-query"
      },
      "id": "0a2f68bf-2ecd-4e23-bc06-219d1b25afe3",
      "name": "Resolve IPv4",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1056,
        176
      ]
    },
    {
      "parameters": {
        "jsCode": "const prevItems = $('Prepare CDN URL').all();\nconst prev = ((prevItems[$itemIndex] || prevItems[0] || {}).json) || {};\n\nlet dns = $json;\nif (typeof dns.data === 'string') {\n  try { dns = JSON.parse(dns.data); } catch (e) {}\n}\n\nconst answers = [].concat(dns.Answer || []).concat(dns.answer || []).concat(Array.isArray(dns.data) ? dns.data : []);\nconst a = answers.find(function (row) {\n  const value = String((row && (row.data || row.ip || row.IPv4)) || '');\n  const isA = row && (Number(row.type) === 1 || String(row.type).toUpperCase() === 'A');\n  return isA && /^\\d{1,3}(?:\\.\\d{1,3}){3}$/.test(value);\n});\n\nconst cdnUrl = String(prev.cdn_url || '');\nif (!a || !cdnUrl) {\n  throw new Error('No IPv4 address for ' + (prev.cdn_host || prev.video_url || 'unknown host'));\n}\n\nconst pathAndQuery = cdnUrl.replace(/^https?:\\/\\/[^\\/?#]+/i, '');\nreturn [{\n  json: Object.assign({}, prev, {\n    ipv4: a.data,\n    download_url: 'https://' + a.data + pathAndQuery,\n  }),\n}];",
        "mode": "runOnceForAllItems"
      },
