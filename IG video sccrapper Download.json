    {
      "parameters": {
        "jsCode": "const FNA_RE = /^instagram\\.[^.]+\\.fna\\.fbcdn\\.net$/i;\nconst HOST_RE = /^https?:\\/\\/([^\\/?#:]+)/i;\n\nfunction hostnameOf(raw) {\n  const match = String(raw).match(HOST_RE);\n  return match ? match[1] : '';\n}\n\nfunction prepare(json) {\n  const raw = String(json.video_url || '').trim();\n  const originalHost = hostnameOf(raw);\n  if (!raw || !originalHost) return json;\n\n  const host = FNA_RE.test(originalHost) ? 'scontent.cdninstagram.com' : originalHost;\n  const cdnUrl = raw.replace(originalHost, host);\n  return Object.assign({}, json, { cdn_host: host, cdn_url: cdnUrl });\n}\n\nreturn $input.all().map(function (item) {\n  return { json: prepare(Object.assign({}, item.json)) };\n});",
        "mode": "runOnceForAllItems"
      },
      "id": "737532c4-c668-4f07-810e-69f6d7052a06",
      "name": "Prepare CDN URL",
      "type": "n8n-nodes-base.code",
